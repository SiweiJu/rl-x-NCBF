<mujoco model="YOUR_MODEL">
  <compiler angle="radian"/>
  <option timestep="0.002"/>

  <worldbody>
    <!-- ... your robot, ground, etc ... -->

    <!-- One mocap box obstacle -->
    <body name="obstacle" mocap="true" pos="100 100 0.2">
      <geom name="obstacle_geom"
            type="box" size="0.20 0.20 0.20"
            contype="4" conaffinity="2"
            friction="1 0.005 0.0001"
            rgba="0.8 0.2 0.2 1"/>
    </body>

  </worldbody>
</mujoco>